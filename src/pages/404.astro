---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found — Oppression" description="This page doesn't exist.">
  <div class="not-found">
    <h1 class="page-title-centered">Page Not Found</h1>
    <p class="lead" style="max-width:none; text-align:center; margin: 0 auto 2rem;">
      There is no safe place for this page. It may have moved, or never existed.
    </p>
    <div class="btn-row" style="justify-content:center;">
      <a class="btn" href="/">Back to Home</a>
    </div>
  </div>
</Layout>

<style>
  .not-found { padding: 6rem 0; text-align: center; }
</style>
